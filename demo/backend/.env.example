# Required. Generate a long random value and keep it out of source control.
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# The bundled backend/pipeline directory is used by default. These optional
# overrides are only needed when selecting different artifacts.
# PIPELINE_ROOT=./pipeline
# DETECTOR_PATH=./pipeline/models/detectors/seg_model_s_2_best.pt
# SECONDARY_DETECTOR_PATH=./pipeline/models/detectors/seg_model_n_3_best.pt
# Separate the five checkpoint paths with ; on Windows or : on Linux/macOS.
# CLASSIFIER_PATHS=path/to/fold_0/best.pt;path/to/fold_1/best.pt;path/to/fold_2/best.pt;path/to/fold_3/best.pt;path/to/fold_4/best.pt
# THRESHOLDS_PATH=./pipeline/config/gate_thresholds.json
# WHOLE_IMAGE_CLASSIFIER_PATH=./pipeline/models/whole_image/whole_image_classifire_MobileViT_fold4.pt
MODEL_DEVICE=cuda:0
DETECTOR_CONFIDENCE=0.25
DETECTOR_IMAGE_SIZE=512
DETECTOR_RETRY_CONFIDENCE=0.10
DETECTOR_RETRY_IMAGE_SIZE=768
ROI_CONTEXT=1.30
MAX_UPLOAD_BYTES=10485760
PRELOAD_MODELS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
